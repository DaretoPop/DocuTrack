<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DocuTrack"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             xmlns:converters="clr-namespace:DocuTrack.Converters"
             x:Class="DocuTrack.App"
             RequestedThemeVariant="Light">


             
  <Application.DataTemplates>
            <!-- ViewLocator -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
      <FluentTheme/>
      <!-- Styles DIR -->
	  <StyleInclude Source="avares://DocuTrack/Styles/Styles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/LoginStyles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/MainStyles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/AddNewTypeDocStyles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/CertificateTypesStyles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/ExpirationsStyles.axaml"/>
    <StyleInclude Source="avares://DocuTrack/Styles/SailorRowStyles.axaml"/>
    

  </Application.Styles>
    <Application.Resources>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
    </Application.Resources>

</Application>