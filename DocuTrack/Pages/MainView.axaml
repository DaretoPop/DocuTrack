<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        Width="1400" Height="800"
        MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        x:Class="DocuTrack.Pages.MainWindow"
        xmlns:vm="clr-namespace:DocuTrack.Pages"
        xmlns:view="clr-namespace:DocuTrack.Pages"
        x:DataType="vm:MainViewModel"
        Title="DocuTrack">



<!-- Background                   Sidebar  -->
<Grid Background="#808080" ColumnDefinitions="Auto,*">

<!-- Change the pageViews -->
<ContentControl Grid.Column="1" Content="{Binding CurrentPage}"></ContentControl>


                            <!-- Color of Sidebar -->
    <Border Padding="20" Background="#525252" IsVisible="{Binding IsLoggedIn}">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Spacing="12">
                
                <!-- LOGO -->
                <StackPanel Orientation="Horizontal">
                        <Image Classes="main-image"/>
                            <Label Content="{Binding App}" HorizontalAlignment="Left" VerticalAlignment="Stretch" FontSize="30"></Label>
                </StackPanel>

                <!-- POCETNA  -->
                <Button
                    Background="Transparent"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    Command="{Binding GoToPocetnaCommand}"
                    Classes="TransparentHoverButton"
                    Padding="0">

                <Grid ColumnDefinitions="4,*,Auto" VerticalAlignment="Center" Margin="0,4">
    
                    <Rectangle
                        Grid.Column="0"
                        Fill="#FF6347"
                        IsVisible="{Binding IsPocetnaSelected}"
                        Margin="0 0 2 0"/>

                    <!-- 2) Page label -->
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Pocetna}"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Margin="5 0 0 0"/>
                        

                    <!-- 3) Arrow indicator -->
                    <TextBlock
                        Grid.Column="2"
                        Text="◀"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,0,100,0"
                        IsVisible="{Binding IsPocetnaSelected}"/>
                </Grid>
                </Button>

                 <!-- POMORCI -->
                <Button
                    Background="Transparent"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    Command="{Binding GoToPomorciCommand}"
                    Classes="TransparentHoverButton"
                    Padding="0">

                <Grid ColumnDefinitions="4,*,Auto" VerticalAlignment="Center" Margin="0,4">
    
                    <Rectangle
                        Grid.Column="0"
                        Fill="#FF6347"
                        IsVisible="{Binding IsPomorciSelected}"
                        Margin="0 0 2 0"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Pomorci}"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0"/>
                        
                    <TextBlock
                        Grid.Column="2"
                        Text="◀"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,0,95,0"
                        IsVisible="{Binding IsPomorciSelected}"/>
                </Grid>
                </Button>


                <!-- DOKUMENTA -->
           <Button
                Background="Transparent"
                Foreground="White"
                HorizontalAlignment="Stretch"
                Command="{Binding GoToDokumentaCommand}"
                Classes="TransparentHoverButton"
                Padding="0">

                <Grid ColumnDefinitions="4,*,Auto" VerticalAlignment="Center" Margin="0,4">

                    <Rectangle
                        Grid.Column="0"
                        Fill="#FF6347"
                        IsVisible="{Binding IsDokumentaSelected}"
                        Margin="0,0,2,0"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Dokumenta}"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="◀"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,0,70,0"
                        IsVisible="{Binding IsDokumentaSelected}"/>
                </Grid>
                </Button>


            <!-- End of sidebar -->
            </StackPanel>
        
                        <!-- IZADJI--> 
             <Button Grid.Row="1" Content="{Binding Izadji}" Background="Transparent" Foreground="White" HorizontalAlignment="Stretch" FontSize="20"    
                     Command="{Binding ExitCommand}"
                     Classes="TransparentHoverButton">    
                </Button>
            
            </Grid>
        </Border>
    </Grid>
</Window>










