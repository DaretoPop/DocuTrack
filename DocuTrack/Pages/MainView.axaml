<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocuTrack.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        x:Class="DocuTrack.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://DocuTrack/Assets/AppIcon.ico"
        Background="#F5F7FA"
        Title="DocuTrack">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Width="230"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                Padding="16,24"
                IsVisible="{Binding IsLoggedIn}">
            <Grid RowDefinitions="*,Auto">

                <StackPanel Grid.Row="0" Spacing="4">

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                        <Image Classes="main-image" VerticalAlignment="Center"/>
                        <Label Content="{Binding App}" VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>

                    <Border Classes="divider" Margin="0,20,0,16"/>

                    <!-- Početna -->
                    <Button Classes="nav" Command="{Binding GoToPocetnaCommand}">
                        <Border Classes="item" Classes.active="{Binding IsPocetnaSelected}">
                            <TextBlock Text="{Binding Pocetna}"/>
                        </Border>
                    </Button>

                    <!-- Pomorci -->
                    <Button Classes="nav" Command="{Binding GoToPomorciCommand}">
                        <Border Classes="item" Classes.active="{Binding IsPomorciSelected}">
                            <TextBlock Text="{Binding Pomorci}"/>
                        </Border>
                    </Button>

                    <!-- Dokumenta -->
                    <Button Classes="nav" Command="{Binding GoToDokumentaCommand}">
                        <Border Classes="item" Classes.active="{Binding IsDokumentaSelected}">
                            <TextBlock Text="{Binding Dokumenta}"/>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Bottom: zoom + exit -->
                <StackPanel Grid.Row="1" Spacing="12">
                    <StackPanel x:Name="BottomRightCorner" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="tool" Content="-" Command="{Binding DecreaseScaleCommand}"/>
                        <TextBlock Text="{Binding ScalingPercent}" MinWidth="44"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" Foreground="#6B7280"/>
                        <Button Classes="tool" Content="+" Command="{Binding IncreaseScaleCommand}"/>
                    </StackPanel>

                    <Border Classes="divider"/>

                    <Button Classes="nav"
                            Command="{Binding ExitCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Classes="item">
                            <TextBlock Text="{Binding Izadji}"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>