<Styles xmlns="https://github.com/avaloniaui">

  <!-- ============ NEW: page building blocks ============ -->

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.count-badge">
    <Setter Property="Background" Value="#EAF1F8"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.count-text">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#2F5D8A"/>
  </Style>
  <Style Selector="TextBlock.count-text.strong">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- White card -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
  </Style>

  <Style Selector="TextBlock.empty-text">
    <Setter Property="Text" Value="Trenutno nema dokumenata"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,60,0,0"/>
  </Style>

  <!-- Search box -->
  <Style Selector="TextBox.search-box">
    <Setter Property="Width" Value="300"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#CBD5E1"/>
  </Style>
  <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#2F5D8A"/>
  </Style>

  <!-- Primary button -->
  <Style Selector="Button.primary-button">
    <Setter Property="Background" Value="#2F5D8A"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- Pagination -->
  <Style Selector="Border.pagination-bar">
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0,12"/>
  </Style>
  <Style Selector="Button.page-btn">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.page-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F3F4F6"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
  </Style>
  <Style Selector="Button.page-btn:disabled">
    <Setter Property="Opacity" Value="0.35"/>
  </Style>

  <!-- ============ Shared hover for all filled buttons ============ -->
  <Style Selector="Button.primary-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.view-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sticanje-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.obnova-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.refresh-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sacuvaj-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#274F76"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- ============ Existing classes, restyled (names unchanged) ============ -->

  <!-- List area -->
  <Style Selector="ScrollViewer.main-document-scroll">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Padding" Value="20,16,20,0"/>
  </Style>

  <!-- List row container -->
  <Style Selector="Border.document-type-container">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.document-type-container:pointerover">
    <Setter Property="Background" Value="#F9FAFB"/>
  </Style>
  <Style Selector="TextBlock.document-container-text">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Button.view-button">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#2F5D8A"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- Old header / panel styles (kept for other views) -->
  <Style Selector="Border.centerleft-panel">
    <Setter Property="Canvas.Left" Value="200"/>
    <Setter Property="Canvas.Top" Value="80"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Width" Value="1280"/>
    <Setter Property="Height" Value="800"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
  </Style>

  <Style Selector="Border.document-header">
    <Setter Property="Grid.Row" Value="0"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12,12,0,0"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TextBlock.document-text">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Border.right-panel">
    <Setter Property="Grid.Column" Value="2"/>
    <Setter Property="Width" Value="700"/>
    <Setter Property="Height" Value="975"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
  </Style>
  <Style Selector="Border.right-header-panel, Border.sacuvaj-border">
    <Setter Property="Grid.Row" Value="0"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12,12,0,0"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TextBlock.right-header-text">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Border.right-container-panel">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Old filled buttons (kept for other views) -->
  <Style Selector="Button.sticanje-button, Button.obnova-button, Button.refresh-button, Button.sacuvaj-button">
    <Setter Property="Background" Value="#2F5D8A"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.sticanje-button">
    <Setter Property="Width" Value="210"/>
    <Setter Property="Height" Value="38"/>
  </Style>
  <Style Selector="Button.obnova-button, Button.refresh-button">
    <Setter Property="Width" Value="205"/>
    <Setter Property="Height" Value="38"/>
  </Style>
  <Style Selector="Button.sacuvaj-button">
    <Setter Property="Width" Value="120"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="FontSize" Value="15"/>
  </Style>

</Styles>