<Styles xmlns="https://github.com/avaloniaui">

  <!-- The new ExpirationsView also uses shared classes from the other styles files:
       page-title, count-badge, count-text, card, empty-text, search-box,
       pagination-bar, page-btn. Defined below: the table look. -->

  <!-- ============ NEW: table ============ -->

  <Style Selector="TextBlock.table-header">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#6B7280"/>
  </Style>

  <!-- List: each item is a flat card, same as SailorRowView -->
  <Style Selector="ListBox.exp-list">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.exp-list ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="16,4"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="ListBox.exp-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F9FAFB"/>
    <Setter Property="BorderBrush" Value="#CBD5E1"/>
  </Style>
  <Style Selector="ListBox.exp-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.exp-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EAF1F8"/>
    <Setter Property="BorderBrush" Value="#2F5D8A"/>
  </Style>

  <!-- Cells: same fonts as SailorRowView -->
  <Style Selector="TextBlock.imeprezime-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="ListBox.exp-list ListBoxItem:pointerover TextBlock.imeprezime-label, ListBox.exp-list ListBoxItem:selected TextBlock.imeprezime-label">
    <Setter Property="Foreground" Value="#2F5D8A"/>
  </Style>
  <Style Selector="TextBlock.typecert-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="TextBlock.istice-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Cells -->
  <Style Selector="TextBlock.imeprezime-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.typecert-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="#374151"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="TextBlock.istice-label">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ============ Old classes, restyled (kept for any other view) ============ -->

  <Style Selector="Border.exp-main-card">
    <Setter Property="Width" Value="1280"/>
    <Setter Property="Height" Value="800"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
    <Setter Property="Canvas.Left" Value="320"/>
    <Setter Property="Canvas.Top" Value="140"/>
  </Style>

  <Style Selector="Border.exp-main-header">
    <Setter Property="Grid.Row" Value="0"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="CornerRadius" Value="12,12,0,0"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TextBlock.exp-main-text">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Button.gotoprofil-button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <!-- Old search -->
  <Style Selector="Border.search-border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Width" Value="360"/>
    <Setter Property="Height" Value="40"/>
  </Style>
  <Style Selector="Border.search-border:focus-within">
    <Setter Property="BorderBrush" Value="#2F5D8A"/>
  </Style>
  <Style Selector="TextBlock.search-icon">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style Selector="TextBox.search-text">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.search-text:pointerover /template/ Border#PART_BorderElement, TextBox.search-text:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

</Styles>