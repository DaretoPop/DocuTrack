<Styles xmlns="https://github.com/avaloniaui">

<Style Selector="Border.sailor-main-card">
    <Setter Property="Width" Value="1280"/>
    <Setter Property="Height" Value="800"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 20 25 0 #525252"/>
    <Setter Property="Canvas.Left" Value="320"/>
    <Setter Property="Canvas.Top" Value="140"/>
</Style>

<Style Selector="Border.sailor-card-header">
    <Setter Property="Grid.Row" Value="0"/>
    <Setter Property="Background" Value="#F7F7F7"/>
    <Setter Property="CornerRadius" Value="20,20,0,0"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
</Style>

        <Style Selector="TextBlock.sailor-card-header-text">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

<!-- #Number of Sailors -->

<Style Selector="StackPanel.totalcount-stack-panel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,20,0"/>
</Style>



        <!-- Total Count of Sailors -->
<Style Selector="TextBlock.sailors-count-text">
    <Setter Property="FontSize" Value="25"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#333333"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>
            <!-- Ukupan broj -->
                    <Style Selector="TextBlock.sailors-ukupanBroj-text">
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Foreground" Value="#555555"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>


<!-- #Navigation -->

<Style Selector="Border.page-navigation">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Background" Value="#FAFAFA"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="5 0 10 8"/>
    <Setter Property="Width" Value="350"/>
    <Setter Property="Height" Value="60"/>
    <Setter Property="Margin" Value="0 725 0 0"/>
    <Setter Property="BoxShadow" Value="0 20 25 0 #525252"/>
</Style>



<!-- Search -->
<Style Selector="Border.sailor-search-border">
    <Setter Property="Background" Value="#FAFAFA"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Width" Value="350"/>
    <Setter Property="Height" Value="55"/>
    <Setter Property="Canvas.Left" Value="320"/>
    <Setter Property="Canvas.Top" Value="84"/>
</Style>


            <Style Selector="TextBlock.sailor-search-icon">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="#808080"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

<Style Selector="TextBox.sailor-search-text">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#333333"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Watermark" Value="Pretrazi"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Margin" Value="30,0,0,0"/> <!-- Adjust margin to position after icon -->
</Style>


<!-- Border kreiraj -->
<Style Selector="Border.sailor-create-button-frame">
    <Setter Property="Background" Value="#FAFAFA"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Width" Value="180"/>
    <Setter Property="Height" Value="55"/>
    <Setter Property="Canvas.Left" Value="1420"/>
    <Setter Property="Canvas.Top" Value="84"/>
</Style>



</Styles>