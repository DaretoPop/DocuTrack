<Styles xmlns="https://github.com/avaloniaui">

  <!-- Logo -->
  <Style Selector="Image.main-image">
    <Setter Property="Source" Value="avares://DocuTrack/Assets/BlueLogoIMG.png"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- Thin divider line -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#E5E7EB"/>
  </Style>

  <!-- Nav button: flat, no default chrome -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Nav item -->
  <Style Selector="Border.item">
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.nav:pointerover Border.item">
    <Setter Property="Background" Value="#F3F4F6"/>
  </Style>
  <Style Selector="Border.item.active">
    <Setter Property="Background" Value="#EAF1F8"/>
  </Style>
  <Style Selector="Button.nav:pointerover Border.item.active">
    <Setter Property="Background" Value="#EAF1F8"/>
  </Style>
  <Style Selector="Border.item TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="#6B7280"/>
  </Style>
  <Style Selector="Border.item.active TextBlock">
    <Setter Property="Foreground" Value="#2F5D8A"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Small square tool button (zoom) -->
  <Style Selector="Button.tool">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="#1F2937"/>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F3F4F6"/>
    <Setter Property="BorderBrush" Value="#E5E7EB"/>
  </Style>

</Styles>