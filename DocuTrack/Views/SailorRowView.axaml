<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DocuTrack.ViewModels"
             x:Class="DocuTrack.Views.SailorRowView"
             x:DataType="viewModels:SailorViewModel">



    <Button Classes="gotoSailor-button"
            Command="{Binding GoToSailorPageCommand}"
            CommandParameter="{Binding}">
        <Button.Content>
            <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">
                <TextBlock Text="{Binding Fullname}" Classes="row-text"/>
                <TextBlock Text="{Binding GID}" Classes="row1-text"/>
                <TextBlock Text="{Binding Refresh}" Classes="row2-text"/>
            </Grid>
        </Button.Content>
        <Button.Styles>
            <!-- Adding color on hover -->
               <Style Selector="Button:pointerover TextBlock.row-text,
                                Button:pointerover TextBlock.row1-text,
                                Button:pointerover TextBlock.row2-text">
        <Setter Property="Foreground" Value="#5D8AA8"/>
            </Style>
        </Button.Styles>
    </Button>
</UserControl>