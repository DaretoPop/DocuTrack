<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DocuTrack.ViewModels"
             x:Class="DocuTrack.Views.SailorRowView"
             x:DataType="viewModels:SailorViewModel">
    <Button Background="Transparent"
            BorderBrush="Transparent"
            Padding="10"
            HorizontalAlignment="Stretch"
            Command="{Binding GoToSailorPageCommand}"
            CommandParameter="{Binding}">
        <Button.Content>
            <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">
                <TextBlock Text="{Binding Fullname}"
                           FontSize="20"
                           Foreground="#333333"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding GID}"
                           FontSize="20"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Refresh}"
                           FontSize="20"
                           Foreground="#333333"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button.Content>
        <Button.Styles>
            <Style Selector="Button:pointerover">
                <Setter Property="Foreground" Value="#808080"/>
            </Style>
        </Button.Styles>
    </Button>
</UserControl>