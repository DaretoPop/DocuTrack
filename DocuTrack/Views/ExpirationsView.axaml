              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

            <Button Background="Transparent" BorderBrush="Transparent" Padding="10" HorizontalAlignment="Stretch"
                    Command="{Binding GoToProfilPanelCommand}">
              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

               <Button Background="Transparent" BorderBrush="Transparent" Padding="10" HorizontalAlignment="Stretch"
                    Command="{Binding GoToProfilPanelCommand}">
              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Search Field on top-left of the main card -->
    <Border Classes="search-border" Canvas.Left="320"   
                                    Canvas.Top="84">   
<!-- ICON AND TEXT -->
      <DockPanel LastChildFill="True">
        <TextBlock Text="🔍" Classes="search-icon"/>
        <TextBox Classes="search-text" Watermark="Pretrazi po Tipu/Imenu/Prezimenu"/>
      </DockPanel>
    </Border>
    
  </Canvas>
</UserControl>
