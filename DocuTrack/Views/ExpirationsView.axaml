<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:scaling="clr-namespace:DocuTrack.UI.Scaling"
             x:DataType="vm:ExpirationsViewModel"
             x:Class="DocuTrack.Views.ExpirationsView"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             Foreground="#1F2937">

	<LayoutTransformControl>
		<LayoutTransformControl.LayoutTransform>
			<ScaleTransform ScaleX="{Binding ScalingFactor}"
			                ScaleY="{Binding ScalingFactor}"/>
		</LayoutTransformControl.LayoutTransform>

		<Grid RowDefinitions="Auto,*" Margin="40,32">

			<!-- Toolbar: title + count on the left, search on the right -->
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<TextBlock Text="Datumi Isteka Sertifikata" Classes="page-title"/>
					<Border Classes="count-badge">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="Ukupno:" Classes="count-text"/>
							<TextBlock Text="{Binding TotalSertificateCount}" Classes="count-text strong"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<TextBox Grid.Column="1"
				         Text="{Binding SearchTerm, Mode=TwoWay}"
				         Watermark="Pretraga po tipu / imenu / prezimenu"
				         Classes="search-box" Width="360"/>
			</Grid>

			<!-- Card with table + pagination -->
			<Border Grid.Row="1" x:Name="MainCard" Classes="card">
				<Grid RowDefinitions="Auto,*,Auto">

					<!-- Column headers -->
					<Grid Grid.Row="0" ColumnDefinitions="*,*,*" Classes="table-header-row"
					      IsVisible="{Binding !NoCertificates}">
						<TextBlock Grid.Column="0" Text="Ime i prezime" Classes="table-header"/>
						<TextBlock Grid.Column="1" Text="Tip dokumenta" Classes="table-header" HorizontalAlignment="Center"/>
						<TextBlock Grid.Column="2" Text="Datum isteka" Classes="table-header" HorizontalAlignment="Right"/>
					</Grid>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,8">
						<StackPanel Spacing="10">
							<TextBlock Text="Nema dokumenta koji ističu u periodu od 10 meseci (300 dana)"
							           IsVisible="{Binding NoCertificates}"
							           Classes="empty-text"/>

							<ListBox Classes="exp-list"
							         ItemsSource="{Binding PaginatedCertificates}"
							         SelectedItem="{Binding SelectedCertificate, Mode=TwoWay}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="*,*,*" MinHeight="40" VerticalAlignment="Center">
											<TextBlock Grid.Column="0" Text="{Binding SailorName}"
											           Classes="imeprezime-label"/>
											<TextBlock Grid.Column="1" Text="{Binding CertificateTypeName}"
											           Classes="typecert-label"/>
											<TextBlock Grid.Column="2" Text="{Binding DateOfExpiration}"
											           Classes="istice-label"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</ScrollViewer>

					<!-- Pagination -->
					<Border Grid.Row="2" Classes="pagination-bar" IsVisible="{Binding !NoCertificates}">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
						            VerticalAlignment="Center" Spacing="6">
							<Button Content="«" Classes="page-btn"
							        Command="{Binding GoToFirstPageCommand}"
							        IsEnabled="{Binding CanGoToFirstOrPrevious}"/>
							<Button Content="‹" Classes="page-btn"
							        Command="{Binding GoToPreviousPageCommand}"
							        IsEnabled="{Binding CanGoToFirstOrPrevious}"/>
							<TextBlock Text="{Binding CurrentPage}" MinWidth="40"
							           TextAlignment="Center" VerticalAlignment="Center"
							           FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
							<Button Content="›" Classes="page-btn"
							        Command="{Binding GoToNextPageCommand}"
							        IsEnabled="{Binding CanGoToNextOrLast}"/>
							<Button Content="»" Classes="page-btn"
							        Command="{Binding GoToLastPageCommand}"
							        IsEnabled="{Binding CanGoToNextOrLast}"/>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</LayoutTransformControl>
</UserControl>