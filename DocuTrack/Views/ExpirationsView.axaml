<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:ExpirationsViewModel"
             x:Class="DocuTrack.Views.ExpirationsView"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             Foreground="White">



  <!-- Canvas -> for better positions -->
  <Canvas Background="#5D8AA8" Width="1920" Height="1080">
    
    <!-- Main Center Card -->
    <Border x:Name="MainCard" Classes="exp-main-card">  
      <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Classes="exp-main-header">
          <TextBlock Text="Datumi Isteka Sertifikata" Classes="exp-main-text"/>
        </Border>
        <!-- Scroll of rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
          <StackPanel Spacing="10">


              <ListBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                      <DataTemplate>

                          <Button Background="Transparent"
                                  BorderBrush="Transparent"
                                  Padding="10"
                                  HorizontalAlignment="Stretch">

                              <Button.Content>
                                  <Grid Width="1100"
                                        Height="45"
                                        ColumnDefinitions="*,*,*"
                                        VerticalAlignment="Center">

                                      <TextBlock Grid.Column="0"
                                                 Text="{Binding SailorName}"
                                                 Classes="imeprezime-label"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"/>

                                      <StackPanel Grid.Column="1"
                                                  Orientation="Horizontal"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center">
                                          <TextBlock Text="📜"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="Black"/>
                                          <TextBlock Text="{Binding CertificateTypeName}"
                                                     Classes="typecert-label"
                                                     VerticalAlignment="Center"/>
                                      </StackPanel>

                                      <StackPanel Grid.Column="2"
                                                  Orientation="Horizontal"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right">
                                          <TextBlock Text="📅"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="Black"/>
                                          <TextBlock Text="{Binding DateOfExpiration}"
                                                     Classes="istice-label"
                                                     VerticalAlignment="Center"/>
                                      </StackPanel>

                                  </Grid>
                              </Button.Content>

                              <!-- Hover Styles -->
                              <Button.Styles>
                                  <Style Selector="Button:pointerover TextBlock.imeprezime-label">
                                      <Setter Property="Foreground" Value="#5D8AA8"/>
                                  </Style>
                              </Button.Styles>
                          </Button>



                      </DataTemplate>
                  </ListBox.ItemTemplate>
              </ListBox>


          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Search Field on top-left of the main card -->
    <Border Classes="search-border" Canvas.Left="320"   
                                    Canvas.Top="84">   
<!-- ICON AND TEXT -->
      <DockPanel LastChildFill="True">
        <TextBlock Text="🔍" Classes="search-icon"/>
        <TextBox Classes="search-text" Watermark="Pretrazi po Tipu/Imenu/Prezimenu"/>
      </DockPanel>
    </Border>
    
  </Canvas>
</UserControl>
