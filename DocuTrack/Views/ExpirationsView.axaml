                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

            <Button Background="Transparent" BorderBrush="Transparent" Padding="10" HorizontalAlignment="Stretch"
                    Command="{Binding GoToProfilPanelCommand}">
              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

            <Button Background="Transparent" BorderBrush="Transparent" Padding="10" HorizontalAlignment="Stretch"
                    Command="{Binding GoToProfilPanelCommand}">
              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
                </Grid>
              </Button.Content>
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Foreground" Value="#808080"/>             
                </Style>
              </Button.Styles>
            </Button>

            <Button Background="Transparent" BorderBrush="Transparent" Padding="10" HorizontalAlignment="Stretch"
                    Command="{Binding GoToProfilPanelCommand}">
              <Button.Content>
                 <Grid Width="1100" Height="45" ColumnDefinitions="300,500,300" VerticalAlignment="Center">

                  <TextBlock Text="Ime i Prezime" Classes="imeprezime-label"/>
                  <TextBlock Grid.Column="1" Text="📜 Tip Sertifikata" Classes="typecert-label"/>
                  <TextBlock Grid.Column="2" Text="📅 Istice: 2026-05-01" Classes="istice-label"/>
                  
