    </Border>

    <!-- Search Field on top-left of the main card -->
    <Border Classes="search-border" Canvas.Left="320"   
                                    Canvas.Top="84">   
<!-- ICON AND TEXT -->
      <DockPanel LastChildFill="True">
        <TextBlock Text="🔍" Classes="search-icon"/>
        <TextBox Classes="search-text" Watermark="Pretrazi po Tipu/Imenu/Prezimenu"/>
      </DockPanel>
    </Border>
    
  </Canvas>
</UserControl>
