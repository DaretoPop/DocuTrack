<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocuTrack.ViewModels"
        x:DataType="vm:CertificateAcquiredViewModel"
        x:Class="DocuTrack.Views.CertificateAcquiredView"
        Width="420" Height="560"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#FFFFFF"
        Title="DocuTrack">

	<Window.Styles>
		<!-- Inputs fill the dialog width and share one look -->
		<Style Selector="ComboBox.dialog-input, CalendarDatePicker.dialog-input">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Foreground" Value="#1F2937"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="12,0"/>
		</Style>
		<Style Selector="TextBlock.dialog-value">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#1F2937"/>
		</Style>
		<Style Selector="TextBlock.dialog-note">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#6B7280"/>
		</Style>
	</Window.Styles>

	<StackPanel Margin="32,28" Spacing="18">

		<!-- Certificate type -->
		<StackPanel Spacing="6">
			<TextBlock Text="Certificate Type" Classes="field-label"/>

			<TextBlock Text="{Binding PreselectedCertificateType.Name}"
			           Classes="dialog-value"
			           IsVisible="{Binding !IsObnovi}"/>

			<ComboBox Classes="dialog-input"
			          ItemsSource="{Binding CertificateTypes}"
			          SelectedItem="{Binding Certificate.CertificateType, Mode=TwoWay}"
			          IsVisible="{Binding IsObnovi}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<!-- Date acquired -->
		<StackPanel Spacing="6">
			<TextBlock Text="Date Acquired" Classes="field-label"/>
			<CalendarDatePicker Classes="dialog-input"
			                    SelectedDate="{Binding Certificate.DateAcquiredDate, Mode=TwoWay}"/>
		</StackPanel>

		<!-- Date expired -->
		<StackPanel Spacing="6">
			<TextBlock Text="Date Expired" Classes="field-label"/>
			<CalendarDatePicker Classes="dialog-input"
			                    SelectedDate="{Binding Certificate.DateExpirationDate, Mode=TwoWay}"/>
		</StackPanel>

		<!-- Place -->
		<StackPanel Spacing="6">
			<TextBlock Text="Place" Classes="field-label"/>
			<ComboBox Classes="dialog-input"
			          SelectedItem="{Binding Certificate.PlaceComboBox, Mode=TwoWay}">
				<ComboBoxItem Content="Bar"/>
				<ComboBoxItem Content="Kotor"/>
			</ComboBox>
		</StackPanel>

		<!-- Error -->
		<Border Classes="upsert-error"
		        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}">
			<TextBlock Text="{Binding ErrorMessage}" Classes="upsert-error-text"/>
		</Border>

		<!-- Files -->
		<!-- <StackPanel Spacing="6">
			<TextBlock Text="{Binding HowManyFilesAreSelected}"
			           Classes="dialog-note"
			           IsVisible="{Binding HowManyFilesAreSelected, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>

			<Button Content="+ Dodaj Dokumenta" Classes="link-button"
			        HorizontalAlignment="Left"
			        Command="{Binding DodajDokumentaCommand}"
			        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
		</StackPanel> -->

		<!-- Save -->
		<Button Content="Sačuvaj" Classes="primary-button"
		        HorizontalAlignment="Stretch"
		        Command="{Binding SaveCertificateCommand}"
		        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
	</StackPanel>
</Window>