<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:UpsertCertificateTypeViewModel"
             x:Class="DocuTrack.Views.UpsertCertificateTypeView"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             Foreground="#1F2937">

	<UserControl.Styles>
		<Style Selector="TextBox.form-input">
			<Setter Property="MinHeight" Value="44"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#1F2937"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBox.form-input:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
		</Style>
		<Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#2F5D8A"/>
		</Style>
	</UserControl.Styles>

	<LayoutTransformControl>
		<LayoutTransformControl.LayoutTransform>
			<ScaleTransform ScaleX="{Binding ScalingFactor}"
			                ScaleY="{Binding ScalingFactor}"/>
		</LayoutTransformControl.LayoutTransform>

		<Grid RowDefinitions="Auto,*" Margin="40,32">

			<!-- Header: back + title -->
			<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
				<Button Grid.Column="0" Content="← Nazad" Classes="secondary-button"
				        Command="{Binding GoToBackCommand}" Margin="0,0,20,0"/>
				<TextBlock Grid.Column="1" Text="{Binding UpsertTitle}" Classes="page-title"/>
			</Grid>

			<!-- Form card -->
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<Border Classes="card" Padding="32" Width="560"
				        HorizontalAlignment="Center" VerticalAlignment="Top">
					<StackPanel Spacing="22">

						<StackPanel Spacing="6">
							<TextBlock Text="Naziv dokumenta" Classes="field-label"/>
							<TextBox Text="{Binding Naziv}" Classes="form-input"/>
						</StackPanel>

						<!-- Error -->
						<Border Classes="upsert-error"
						        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}">
							<TextBlock Text="{Binding ErrorMessage}" Classes="upsert-error-text"/>
						</Border>

						<!-- Actions -->
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
							<Button Content="Izbriši" Classes="danger-button"
							        IsVisible="{Binding IsNew}"
							        Command="{Binding DeleteCommand}"
							        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
							<Button Content="Sačuvaj" Classes="primary-button" MinWidth="110"
							        Command="{Binding SaveCommand}"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</ScrollViewer>
		</Grid>
	</LayoutTransformControl>
</UserControl>