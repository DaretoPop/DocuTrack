<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             x:DataType="vm:CertificateTypesViewModel"
             x:Class="DocuTrack.Views.CertificateTypesView"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             Foreground="White">




  <Grid Background="#808080">

    <!-- MAIN PANEL -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/> <!-- Center card -->
        <ColumnDefinition Width="20"/>   <!-- Spacer -->
        <ColumnDefinition Width="Auto"/> <!-- Right panel -->
      </Grid.ColumnDefinitions>

      <!-- Center/Left Panel -->
      <Border Grid.Column="0" 
        Width="1000" Height="900"
        Background="White"
        CornerRadius="20"
        BorderBrush="#E0E0E0" BorderThickness="2"
        BoxShadow="0 20 25 0 #525252">
  <Grid RowDefinitions="Auto,*,Auto">
    
    <!-- Header  TIP DOKUMENATA -->
    <Border Grid.Row="0"
            Background="#F7F7F7"
            CornerRadius="20,20,0,0"
            Padding="20"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
      <TextBlock Text="Tip Dokumenata"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#333333"
                 HorizontalAlignment="Center"/>
    </Border>

    <!-- Scroll List -->
    <ScrollViewer Grid.Row="1" 
