<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             x:DataType="vm:CertificateTypesViewModel"
             x:Class="DocuTrack.Views.CertificateTypesView"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             Foreground="White">




  <Grid Background="#808080">

    <!-- MAIN PANEL -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/> <!-- Center card -->
        <ColumnDefinition Width="20"/>   <!-- Spacer -->
        <ColumnDefinition Width="Auto"/> <!-- Right panel -->
      </Grid.ColumnDefinitions>

      <!-- Center/Left Panel -->
      <Border Grid.Column="0" Classes="centerleft-panel">

  <Grid RowDefinitions="Auto,*,Auto">
    
    <!-- Header  TIP DOKUMENATA -->
    <Border Classes="document-header">
       <TextBlock Text="Tip Dokumenata" Classes="document-text"/>
    </Border>

    <!-- Scroll List -->
    <ScrollViewer Classes="main-document-scroll">
      <StackPanel Spacing="12" Margin="0,0,0,20">


        <Border Background="#FAFAFA" >
          </Border>

          <!-- This is just static(Design) -->
          <ItemsControl ItemsSource="{Binding PaginatedCertificateTypes}">
              <ItemsControl.ItemTemplate>
                  <DataTemplate>
                      <views:CertificateTypeRowView DataContext="{Binding}" />
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>

          

      </StackPanel>
    </ScrollViewer>


    <Border Grid.Row="1" Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="5 0 10 8"
            Width="350" Height="60"
            Margin="0 725 0 0"
            BoxShadow="0 20 25 0 #525252">

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="5" VerticalAlignment="Bottom">

            <Button Content="First" Command="{Binding GoToFirstPageCommand}" IsEnabled="{Binding CanGoToFirstOrPrevious}" MinHeight="30" Margin="0 0 0 0"/>
            <Button Content="Previous" Command="{Binding GoToPreviousPageCommand}" IsEnabled="{Binding CanGoToFirstOrPrevious}" MinWidth="20" MinHeight="30"/>
            <TextBlock Text="{Binding CurrentPage}" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"  />
            <Button Content="Next" Command="{Binding GoToNextPageCommand}" IsEnabled="{Binding CanGoToNextOrLast}" MinHeight="30" Margin=" 0 0 3 0"/>
            <Button Content="Last" Command="{Binding GoToLastPageCommand}" IsEnabled="{Binding CanGoToNextOrLast}" MinHeight="30" />

        </StackPanel>
    </Border>


	  <!-- Kreiraj Button -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0">
      <Button Content="Kreiraj Dokument" Command="{Binding GoToAddNewDocumentCommand}" Classes="create-document-button"/>
    </StackPanel>
  </Grid>
</Border>


<!-- ############################################################################################ -->

      <!-- Right Panel - Fixed layout-->
      <Border Classes="right-panel" IsVisible="{Binding IsRightPanelVisible}">
        <Grid Margin="20">

          <Grid.RowDefinitions>
            <!-- Fixed Header -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Border Classes="right-header-panel">
              <TextBlock Text="Novi/Izmeni" Classes="right-header-text"/>
          </Border>

          <!-- Scroll is auto in listbox -->
          <StackPanel Grid.Row="1" Spacing="9" Margin="0,10,0,10">

            <!-- Sticanje -->
            <StackPanel Spacing="10">
              <TextBlock Text="Ime Tipa:" FontSize="16" Foreground="#555555"/>
              <TextBlock Text="Sertifikat 1" FontSize="20" FontWeight="Bold" Foreground="#333333"/>
         <TextBlock Text="Sticanje:" FontSize="16" Foreground="#555555"/>

            </StackPanel>
            <Border Classes="right-container-panel">

              <ListBox MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
              </ListBox>
            </Border>
            <Button Content="Dodaj Zahtev za Sticanje" Classes="sticanje-button"/>

            <!-- Obnova -->
            <StackPanel Spacing="10">
              <TextBlock Text="Obnova:" FontSize="16" Foreground="#555555"/>
            </StackPanel>

              <Border Classes="right-container-panel">

              <ListBox MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
              </ListBox>
            </Border>
            <Button Content="Dodaj Zahtev za Obnovu" Classes="obnova-button"/>

            <!-- Refresh  -->
            <StackPanel Spacing="10">
              <TextBlock Text="Refresh:" FontSize="16" Foreground="#555555"/>
            </StackPanel>
            <Border Classes="right-container-panel">

              <ListBox MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" FontWeight="Bold" Foreground="#333333"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
                <ListBoxItem>
                  <TextBlock Text="document.pdf" Foreground="Red"/>
                </ListBoxItem>
              </ListBox>
            </Border>
            <Button Content="Dodaj Zahtev za Refresh" Classes="refresh-button"/>
          </StackPanel>

          <!-- Static Sacuvaj Button -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
  <Border Classes="sacuvaj-border">
  <Button Content="Sacuvaj" Command="{Binding ToggleRightPanelCommand}" Classes="sacuvaj-button"/>
</Border> 

</StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
