<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:SailorViewModel"
             x:Class="DocuTrack.Views.SailorView">


<!-- Profil Panel -->

<Canvas Background="#808080" Width="1920" Height="1080">


    <Border Classes="sailorview-main-panel">
      <Grid Margin="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Profil Panel Header -->
        <Border Classes="sailor-profile-header">
            <Grid ColumnDefinitions="350,200,300,550" VerticalAlignment="Center">

              <TextBlock Text="{Binding Fullname}" Classes="profil-name"/>
              <TextBlock Text="{Binding GID}" Classes="profil-gid"/>
              <TextBlock Text="{Binding Refresh}"
                        Grid.Column="2"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#333333"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
              <Button Content="EDIT" Classes="profile-edit-button" Command="{Binding GoToEditSailorPageCommand}"/>
          </Grid>
        </Border>
        
        <!-- Profil Panel Content -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10"/> <!-- Vertical Separator -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          
          <!-- TOP of Panel leftSide -->
          <StackPanel Grid.Column="0" Spacing="10">
            <ListBox Classes="sailor-documents-list1">

              <ListBoxItem><TextBlock Text="Item 1" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Item 2" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Item 3" /></ListBoxItem>
            </ListBox>

           <!-- Grid if is need to add more button in same row -->
            <Grid Width="625" Height="60" ColumnDefinitions="100,90,300" VerticalAlignment="Center">

<!-- STICANJE BUTTON -->
                 <Button Content="Sticanje" Classes="sailor-sticanje-button"/>
                </Grid>

                <!-- Separator between upper and lower LEFT SIDE -->


                <!-- Bottom of Panel LeftSide -->
               <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Skenirana Dokumenta" Classes="skenirana-dokumenta"/>
                 <!-- Divider line -->
                    <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="250" HorizontalAlignment="Center"/>
              </StackPanel>

               <StackPanel Grid.Column="0" Spacing="10">
            <ListBox Classes="sailor-documents-list2">

              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
            </ListBox>
            </StackPanel>
<!-- Stmapaj BUTTON -->
            <Button Content="Stampaj" Classes="sailor-print-button"/>              

          </StackPanel>
          
          <!-- Vertical Separator -->
          <Border Grid.Column="1" Background="#e0e0e0" Width="5"/>
          
<!-- ############################################################################### -->
          
        <!-- RIGHT SIDE of Profil Panel -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Upper Side of Right Panel-->
            <StackPanel Grid.Row="0" Spacing="50" HorizontalAlignment="Center" VerticalAlignment="Center">
<!-- Tip -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                  <TextBlock Classes="sailor-tip-text"/>
                  <TextBlock Text="Certifikat 1" Classes="sailor-certificate-name"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Izdavanje -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                  <TextBlock Text="Datum Izdavanja" Classes="sailor-izdavanje-text"/>
                  <TextBlock Text="31.05.2024" Classes="sailor-izdavanje-datum"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Istek -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                  <TextBlock Text="Datum Isteka" Classes="sailor-istek-text"/>
                  <TextBlock Text="31.05.2026"   Classes="sailor-istek-datum"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Mesto Izdavanja -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                  <TextBlock Text="Mesto Izdavanja" Classes="sailor-mestoizdavanja"/>
                  <TextBlock Text="Bar/Kotor" Classes="sailor-filijala"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            
            <!-- Horizontal Thick Separator -->
            <Border Grid.Row="1" Background="#e0e0e0" Height="5" Margin="0,20"/>
            
            <!-- Lower Part of RightSIDE-->
            <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Zahtevi field -->
                <RowDefinition Height="Auto"/>   <!-- Grid with 3 Request Buttons -->
                <RowDefinition Height="Auto"/>   <!-- Obnovi Dokument field -->
                <RowDefinition Height="Auto"/>   <!-- OBNOVI Button -->
                <RowDefinition Height="Auto"/>   <!-- StareVerzije Button -->
              </Grid.RowDefinitions>
              
              <!-- Row 0: "Zahtevi" Field -->
              <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="5" Margin="0,0,0,20">
                  <TextBlock Text="Zahtevi" FontSize="18" Foreground="#555555" HorizontalAlignment="Center"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
              
              
              <Grid Grid.Row="1" Width="605" Height="45" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                  <Button Content="Zahtev za Obnovu" Classes="sailor-zahtev-button"/>
                  <Button Content="Zahtev za Refresh" Classes="sailor-refresh-button"/>
                  <Button Content="Zahtev za Sticanje" Classes="sailor-zahtev-sticanje-button"/>
              </Grid>
              
              <!-- Obnovi Dokument -->
              <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="5" Margin="10,40,0,20">
                  <TextBlock Text="Obnovi Dokument" FontSize="18" Foreground="#555555" HorizontalAlignment="Center"/>
                  <Rectangle Height="1" Fill="#cccccc" StrokeDashArray="4,2" Width="200" HorizontalAlignment="Center"/>
              </StackPanel>
            
              <!--OBNOVI BUTTON -->
              <Button Content="OBNOVI" Classes="sailor-obnovi-button"/>
              
              <!-- >Stare Verzije -->
                       <Button Grid.Row="4" Content="> Stare Verzije" Background="Transparent" Foreground="Black" HorizontalAlignment="Stretch" FontSize="17" Margin="0,30,0,100" 
                               Classes="TransparentHoverButton">
                      </Button>

            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    
    <!-- BACK BUTTON -->
    <Border Classes="sailor-back-border2">
      <Grid>
        <Button  Command="{Binding GoBackCommand}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Classes="TransparentHoverButton">
        <Image   Classes="sailor-back-image"/>

      </Button>
      </Grid>
    </Border>
</Canvas>
</UserControl>


