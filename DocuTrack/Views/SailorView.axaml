<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:SailorViewModel"
             x:Class="DocuTrack.Views.SailorView">


<!-- Profil Panel -->

<Canvas Background="#808080" Width="1920" Height="1080">


    <Border Width="1300" Height="900"
           
            Background="White"
            CornerRadius="30"
            BorderBrush="#E0E0E0"
            BorderThickness="10"
            BoxShadow="0 20 30 10 #525252"
            VerticalAlignment="Center"
            Canvas.Left="320"
            Canvas.Top="70">
      <Grid Margin="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Profil Panel Header -->
        <Border Grid.Row="0"
                Background="#F7F7F7"
                Padding="15"
                CornerRadius="20,20,0,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="350,200,300,550" VerticalAlignment="Center">

              <TextBlock Text="Ime i Prezime"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#333333"
                        VerticalAlignment="Center"/>
              <TextBlock Text="1234567898765"
                        Grid.Column="1"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#333333"
                        VerticalAlignment="Center"/>
              <TextBlock Text="Refresh*"
                        Grid.Column="2"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#333333"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
              <Button Grid.Column="3" Content="EDIT"
                        Background="#808080"
                        Foreground="White"
                        FontSize="20"
                        Padding="10,5"
                        HorizontalAlignment="Center"
                        CornerRadius="8"
                        Width="70"
                        Height="45"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
          </Grid>
        </Border>
        
        <!-- Profil Panel Content -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10"/> <!-- Vertical Separator -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          
          <!-- TOP of Panel leftSide -->
          <StackPanel Grid.Column="0" Spacing="10">
            <ListBox Height="300"
                     BorderBrush="#e0e0e0"
                     BorderThickness="1"
                     CornerRadius="5">

              <ListBoxItem><TextBlock Text="Item 1" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Item 2" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Item 3" /></ListBoxItem>
            </ListBox>

           <!-- Grid if is need to add more button in same row -->
            <Grid Width="625" Height="60" ColumnDefinitions="100,90,300" VerticalAlignment="Center">

<!-- STICANJE BUTTON -->
                 <Button Content="Sticanje"
                    Background="#808080"
                    Foreground="White"
                    FontSize="18"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Height="45"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Separator between upper and lower LEFT SIDE -->


                <!-- Bottom of Panel LeftSide -->
               <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Skenirana Dokumenta"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                 
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="250"
                           HorizontalAlignment="Center"/>
                           
              </StackPanel>

               <StackPanel Grid.Column="0" Spacing="10">
            <ListBox Height="270"
                     BorderBrush="#e0e0e0"
                     BorderThickness="1"
                     CornerRadius="5">

              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
              <ListBoxItem><TextBlock Text="Skeniran Sertifikat.pdf" /></ListBoxItem>
            </ListBox>
            </StackPanel>
<!-- Stmapaj BUTTON -->
            <Button Content="Stampaj"
                    Background="#808080"
                    Foreground="White"
                    FontSize="18"
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Height="45"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>              

          </StackPanel>
          
          <!-- Vertical Separator -->
          <Border Grid.Column="1" Background="#e0e0e0" Width="5"/>
          
<!-- ############################################################################### -->
          
        <!-- RIGHT SIDE of Profil Panel -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Upper Side of Right Panel-->
            <StackPanel Grid.Row="0"
                        Spacing="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
<!-- Tip -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Tip"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Certifikat 1"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Izdavanje -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Datum Izdavanja"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="31.05.2024"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Istek -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Datum Isteka"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="31.05.2026"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
<!-- Mesto Izdavanja -->
              <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Mesto Izdavanja"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Bar/Kotor"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            
            <!-- Horizontal Thick Separator -->
            <Border Grid.Row="1"
                    Background="#e0e0e0"
                    Height="5"
                    Margin="0,20"/>
            
            <!-- Lower Part of RightSIDE-->
            <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Zahtevi field -->
                <RowDefinition Height="Auto"/>   <!-- Grid with 3 Request Buttons -->
                <RowDefinition Height="Auto"/>   <!-- Obnovi Dokument field -->
                <RowDefinition Height="Auto"/>   <!-- OBNOVI Button -->
                <RowDefinition Height="Auto"/>   <!-- StareVerzije Button -->

              </Grid.RowDefinitions>
              
              <!-- Row 0: "Zahtevi" Field -->
              <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="5" Margin="0,0,0,20">
                <TextBlock Text="Zahtevi"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
              
              
              <Grid Grid.Row="1" Width="605" Height="45" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
<!-- Zahtev -->
                  <Button Grid.Column="0"
                          Content="Zahtev za Obnovu"
                          Background="#808080"
                          Foreground="White"
                          FontSize="18"
                          Padding="10,5"
                          HorizontalAlignment="Center"
                          CornerRadius="8"
                          Width="180"
                          Height="45"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"/>
<!-- Refresh -->
                  <Button Grid.Column="2"
                          Content="Zahtev za Refresh"
                          Background="#808080"
                          Foreground="White"
                          FontSize="18"
                          Padding="10,5"
                          HorizontalAlignment="Center"
                          CornerRadius="8"
                          Width="180"
                          Height="45"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"/>
<!-- Sticanje -->
                  <Button Grid.Column="4"
                          Content="Zahtev za Sticanje"
                          Background="#808080"
                          Foreground="White"
                          FontSize="18"
                          Padding="10,5"
                          HorizontalAlignment="Center"
                          CornerRadius="8"
                          Width="180"
                          Height="45"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"/>
              </Grid>
              
              <!-- Obnovi Dokument -->
              <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="5" Margin="10,40,0,20">
                <TextBlock Text="Obnovi Dokument"
                           FontSize="18"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="1"
                           Fill="#cccccc"
                           StrokeDashArray="4,2"
                           Width="200"
                           HorizontalAlignment="Center"/>
              </StackPanel>
              
              <!--OBNOVI BUTTON -->
              <Button Grid.Row="3"
                      Content="OBNOVI"
                      Background="#808080"
                      Foreground="White"
                      FontSize="18"
                      Padding="10,5"
                      HorizontalAlignment="Center"
                      CornerRadius="8"
                      Width="180"
                      Height="45"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="10,0,0,0"/>

              <!-- >Stare Verzije -->
                       <Button Grid.Row="4" Content="> Stare Verzije" Background="Transparent" Foreground="Black" HorizontalAlignment="Stretch" FontSize="17"
                      Margin="0,30,0,100">
                        <Button.Styles>
                          <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="TextBlock.Foreground" Value="#808080"/>
                          </Style>
                        </Button.Styles>
                    </Button>

            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    
    <!-- BACK BUTTON -->
    <Border Width="50" Height="40"
            BoxShadow="0 15 30 2 #525252"
            Background="White"
            CornerRadius="15"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            VerticalAlignment="Center"
            Canvas.Left="200"
            Canvas.Top="972">
      <Grid>
        <Button Background="Transparent"
              Command="{Binding GoBackCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Classes="TransparentHoverButton">
        <Image Source="avares://DocuTrack/Assets/Back.png"
               Width="25"
               Height="25"
               Stretch="Uniform"/>
      </Button>

        
      </Grid>
    </Border>

</Canvas>
</UserControl>


