<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:SailorViewModel"
             x:Class="DocuTrack.Views.SailorView"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             Foreground="#1F2937">

	<LayoutTransformControl>
		<LayoutTransformControl.LayoutTransform>
			<ScaleTransform ScaleX="{Binding ScalingFactor}"
			                ScaleY="{Binding ScalingFactor}"/>
		</LayoutTransformControl.LayoutTransform>

		<Grid RowDefinitions="Auto,*" Margin="40,32">

			<!-- ========== Header: back, name, GID, refresh, edit ========== -->
			<Border Grid.Row="0" Classes="card" Padding="20,14" Margin="0,0,0,20">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">

					<Button Grid.Column="0" Content="← Nazad" Classes="secondary-button"
					        Command="{Binding GoBackCommand}" Margin="0,0,20,0"/>

					<TextBlock Grid.Column="1" Text="{Binding Fullname}" Classes="profile-name"/>
					<TextBlock Grid.Column="2" Text="{Binding GID}" Classes="profile-gid" Margin="0,0,28,0"/>
					<TextBlock Grid.Column="3" Text="{Binding Refresh}" Classes="profile-refresh" Margin="0,0,28,0"/>
					<Button Grid.Column="4" Content="Izmeni" Classes="primary-button"
					        Command="{Binding GoToEditSailorPageCommand}"/>
				</Grid>
			</Border>

			<!-- ========== Content ========== -->
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<Grid ColumnDefinitions="*,20,*">

					<!-- ===== LEFT: certificates + scanned documents ===== -->
					<Border Grid.Column="0" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="16">

							<TextBlock Text="Dokumenta" Classes="section-title"/>

							<ListBox Classes="sailor-documents-list1"
							         ItemsSource="{Binding Certificates}"
							         SelectedItem="{Binding SelectedCertificateListBox, Mode=TwoWay}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<TextBlock IsVisible="{Binding isNew}" Text="{Binding Name}"/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

							<Grid ColumnDefinitions="Auto,*,Auto">
								<Button Grid.Column="0" Content="Sticanje" Classes="primary-button"
								        Command="{Binding SticanjeCommand}"
								        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
								<Button Grid.Column="2" Content="Obriši" Classes="danger-button"
								        Command="{Binding DeleteCommand}"
								        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
								        IsVisible="{Binding IsCertificateSelected}"/>
							</Grid>

							<!-- Scanned documents (only when a certificate is selected) -->
							<StackPanel Spacing="16" IsVisible="{Binding IsCertificateSelected}">
								<Border Classes="divider"/>

								<TextBlock Text="Skenirana Dokumenta" Classes="section-title"/>

								<ListBox Classes="sailor-documents-list2"
								         ItemsSource="{Binding ScannedDocuments}"
								         SelectedItems="{Binding SelectedFiles, Mode=TwoWay}"
								         SelectionMode="Multiple">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding FilePath}"/>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

								<Grid ColumnDefinitions="Auto,Auto,*,Auto">
									<Button Grid.Column="0" Content="Dodaj" Classes="primary-button"
									        Command="{Binding DodajDokumentCommand}"
									        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
									<Button Grid.Column="1" Content="Štampaj" Classes="secondary-button"
									        Command="{Binding PrintCommand}" Margin="10,0,0,0"/>
									<Button Grid.Column="3" Content="Obriši" Classes="danger-button"
									        Command="{Binding DeleteSkeniranoCommand}"/>
								</Grid>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- ===== RIGHT: details, requests, renew ===== -->
					<Border Grid.Column="2" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="20">

							<!-- Hint when nothing is selected -->
							<TextBlock Text="Izaberite dokument da vidite detalje"
							           Classes="empty-text"
							           Margin="0,40"
							           IsVisible="{Binding !IsCertificateSelected}"/>

							<StackPanel Spacing="20" IsVisible="{Binding IsCertificateSelected}">

								<!-- Details -->
								<TextBlock Text="Detalji dokumenta" Classes="section-title"/>

								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
									<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
										<TextBlock Text="Naziv/Tip" Classes="field-label"/>
										<TextBlock Text="{Binding SelectedCertificate.Name}" Classes="field-value"/>
									</StackPanel>
									<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,18">
										<TextBlock Text="Mesto Izdavanja" Classes="field-label"/>
										<TextBlock Text="{Binding SelectedCertificate.Place}" Classes="field-value"/>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="0">
										<TextBlock Text="Datum Izdavanja" Classes="field-label"/>
										<TextBlock Text="{Binding SelectedCertificate.DateAcquired}" Classes="field-value"/>
									</StackPanel>
									<StackPanel Grid.Row="1" Grid.Column="1">
										<TextBlock Text="Datum Isteka" Classes="field-label"/>
										<TextBlock Text="{Binding SelectedCertificate.DateExpiration}" Classes="field-value"/>
									</StackPanel>
								</Grid>

								<Border Classes="divider"/>

								<!-- Requests -->
								<TextBlock Text="Zahtevi" Classes="section-title"/>

								<Grid ColumnDefinitions="*,10,*,10,*">
									<Button Grid.Column="0" Content="Zahtev za Obnovu" Classes="secondary-button wide"
									        Command="{Binding ZahtevZaObnovuCommand}"/>
									<Button Grid.Column="2" Content="Zahtev za Refresh" Classes="secondary-button wide"
									        Command="{Binding ZahtevZaRefreshCommand}"/>
									<Button Grid.Column="4" Content="Zahtev za Sticanje" Classes="secondary-button wide"
									        Command="{Binding ZahtevZaSticanjeCommand}"
									        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
								</Grid>

								<Border Classes="divider"/>

								<!-- Renew -->
								<TextBlock Text="Obnovi Dokument" Classes="section-title"/>

								<Button Content="Obnovi" Classes="primary-button"
								        HorizontalAlignment="Left"
								        Command="{Binding OBNOVICommand}"
								        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

								<Button Content="Stare verzije  ›" Classes="link-button"
								        HorizontalAlignment="Left"
								        IsVisible="{Binding haveMultipleVersions}"
								        Command="{Binding StareVerzijeCommand}"
								        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

								<Border Classes="upsert-error"
								        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}">
									<TextBlock Text="{Binding ErrorMessage}" Classes="upsert-error-text"/>
								</Border>
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>
			</ScrollViewer>
		</Grid>
	</LayoutTransformControl>
</UserControl>