<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             x:DataType="vm:SailorsViewModel"
             x:Class="DocuTrack.Views.SailorsView"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             Foreground="White">

 <!-- Canvas -> for better positions -->
  <Canvas Background="#808080" Width="1920" Height="1080">
    
    <!-- Main Center Card -->
    <Border x:Name="MainCard"
            Width="1280" Height="800"
            Background="White"
            CornerRadius="20"
            BorderBrush="#E0E0E0" BorderThickness="1"
            BoxShadow="0 20 25 0 #525252"
            Canvas.Left="320"   
            Canvas.Top="140">   
      <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#F7F7F7"
                CornerRadius="20,20,0,0"
                Padding="20"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
          <TextBlock Text="Profil Pomorca"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="#333333"
                     HorizontalAlignment="Center"/>
        </Border>
        <!-- Scroll of rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
          <StackPanel Spacing="10">



			  <!-- one row -->
              <ItemsControl ItemsSource="{Binding PaginatedSailors}">
				  <ItemsControl.ItemTemplate>
					  <DataTemplate>
						  <views:SailorRowView DataContext="{Binding}" />
					  </DataTemplate>
				  </ItemsControl.ItemTemplate>
              </ItemsControl>

            
              

			  <!-- end of one row -->
            

          </StackPanel>
        </ScrollViewer>

        <!-- Border of pages navigations -->
        <Border Grid.Row="1" Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="5 0 10 8"
            Width="350" Height="60"
            Margin="0 725 0 0"
            BoxShadow="0 20 25 0 #525252">

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="5" VerticalAlignment="Bottom">
           
			<Button Content="First" Command="{Binding GoToFirstPageCommand}" IsEnabled="{Binding CanGoToFirstOrPrevious}" MinHeight="30" Margin="0 0 0 0"/>
            <Button Content="Previous" Command="{Binding GoToPreviousPageCommand}" IsEnabled="{Binding CanGoToFirstOrPrevious}" MinWidth="20" MinHeight="30"/>
            <TextBlock Text="{Binding CurrentPage}" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"  />
            <Button Content="Next" Command="{Binding GoToNextPageCommand}" IsEnabled="{Binding CanGoToNextOrLast}" MinHeight="30" Margin=" 0 0 3 0"/>
            <Button Content="Last" Command="{Binding GoToLastPageCommand}" IsEnabled="{Binding CanGoToNextOrLast}" MinHeight="30" />
           
        </StackPanel>
         </Border>
      </Grid>
    </Border>


    <!-- Search MAIN BORDER-->
    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="10"
            Width="350" Height="55"
            Canvas.Left="320"   
            Canvas.Top="84">   

      <!-- Using a DockPanel to arrange the icon and TextBox side by side -->
      <DockPanel LastChildFill="True">
        <!-- iCON -->
        <TextBlock Text="🔍" 
                   FontSize="20" 
                   Foreground="#808080" 
                   VerticalAlignment="Center" 
                   Margin="0,0,8,0"
                   DockPanel.Dock="Left"/>
        <!-- Search TextBox -->
        <TextBox Background="Transparent"
                 BorderThickness="0"
                 Foreground="#333333"
                 FontSize="16"
                 VerticalAlignment="Center"
                 Watermark="Pretrazi"
                 Text="{Binding SearchTerm, Mode=TwoWay}"
                 VerticalContentAlignment="Center"/>
      </DockPanel>
    </Border>

      <!-- Kreiraj Pomorca -->
    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="10"
            Width="180" Height="55"
            Canvas.Left="1420"   
            Canvas.Top="84">   


    <Button Content="Kreiraj Pomorca" Background="Transparent" Foreground="Black" HorizontalAlignment="Stretch" FontSize="18"
            Command="{Binding GoToKreirajPomorcaPageCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="TextBlock.Foreground" Value="#808080"/>
                        </Style>
                    </Button.Styles>      
                </Button>
    </Border>

    
  </Canvas>
</UserControl>