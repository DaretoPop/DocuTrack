<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             x:DataType="vm:SailorsViewModel"
             x:Class="DocuTrack.Views.SailorsView"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             Foreground="#1F2937">

	<LayoutTransformControl>
		<LayoutTransformControl.LayoutTransform>
			<ScaleTransform ScaleX="{Binding ScalingFactor}"
			                ScaleY="{Binding ScalingFactor}"/>
		</LayoutTransformControl.LayoutTransform>

		<Grid RowDefinitions="Auto,*" Margin="40,32">

			<!-- Toolbar: title on the left, search + create on the right -->
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<TextBlock Text="Profil Pomorca" Classes="page-title"/>
					<Border Classes="count-badge">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="Pomorci:" Classes="count-text"/>
							<TextBlock Text="{Binding TotalSailorsCount}" Classes="count-text strong"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
					<TextBox Text="{Binding SearchTerm, Mode=TwoWay}"
					         Watermark="Pretraga..."
					         Classes="search-box"/>
					<Button Content="Kreiraj Pomorca"
					        Command="{Binding GoToKreirajPomorcaPageCommand}"
					        Classes="primary-button"/>
				</StackPanel>
			</Grid>

			<!-- Card with column headers + list + pagination -->
			<Border Grid.Row="1" x:Name="MainCard" Classes="card">
				<Grid RowDefinitions="Auto,*,Auto">

					<!-- Column headers (same column widths as SailorRowView) -->
					<Grid Grid.Row="0" ColumnDefinitions="2*,*,*"
					      Margin="37,16,37,0"
					      IsVisible="{Binding !NoData}">
						<TextBlock Grid.Column="0" Text="Ime i prezime" Classes="table-header"/>
						<TextBlock Grid.Column="1" Text="JMBG" Classes="table-header"/>
						<TextBlock Grid.Column="2" Text="Status" Classes="table-header"
						           HorizontalAlignment="Right"/>
					</Grid>

					<ScrollViewer Grid.Row="1" Classes="main-document-scroll">
						<StackPanel Spacing="10" Margin="0,0,0,12">
							<TextBlock Text="Trenutno nema pomorca"
							           IsVisible="{Binding NoData}"
							           Classes="empty-text"/>
							<ItemsControl ItemsSource="{Binding PaginatedSailors}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<views:SailorRowView DataContext="{Binding}"
										                     Margin="0,0,0,10"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>

					<!-- Pagination -->
					<Border Grid.Row="2" Classes="pagination-bar" IsVisible="{Binding !NoData}">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
						            VerticalAlignment="Center" Spacing="6">
							<Button Content="«" Classes="page-btn"
							        Command="{Binding GoToFirstPageCommand}"
							        IsEnabled="{Binding CanGoToFirstOrPrevious}"/>
							<Button Content="‹" Classes="page-btn"
							        Command="{Binding GoToPreviousPageCommand}"
							        IsEnabled="{Binding CanGoToFirstOrPrevious}"/>
							<TextBlock Text="{Binding CurrentPage}" MinWidth="40"
							           TextAlignment="Center" VerticalAlignment="Center"
							           FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
							<Button Content="›" Classes="page-btn"
							        Command="{Binding GoToNextPageCommand}"
							        IsEnabled="{Binding CanGoToNextOrLast}"/>
							<Button Content="»" Classes="page-btn"
							        Command="{Binding GoToLastPageCommand}"
							        IsEnabled="{Binding CanGoToNextOrLast}"/>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</LayoutTransformControl>
</UserControl>