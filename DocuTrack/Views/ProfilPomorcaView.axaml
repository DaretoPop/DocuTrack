    </Border>


    <!-- Search MAIN BORDER-->
    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="10"
            Width="350" Height="55"
            Canvas.Left="320"   
            Canvas.Top="84">   

      <!-- Using a DockPanel to arrange the icon and TextBox side by side -->
      <DockPanel LastChildFill="True">
        <!-- iCON -->
        <TextBlock Text="🔍" 
                   FontSize="20" 
                   Foreground="#808080" 
                   VerticalAlignment="Center" 
                   Margin="0,0,8,0"
                   DockPanel.Dock="Left"/>
        <!-- Search TextBox -->
        <TextBox Background="Transparent"
                 BorderThickness="0"
                 Foreground="#333333"
                 FontSize="16"
                 VerticalAlignment="Center"
                 Watermark="Pretrazi po Imenu/Prezimenu/JMBG"/>
      </DockPanel>
    </Border>

      <!-- Kreiraj Pomorca -->
    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="10"
            Width="180" Height="55"
            Canvas.Left="1420"   
            Canvas.Top="84">   


    <Button Content="Kreiraj Pomorca" Background="Transparent" Foreground="Black" HorizontalAlignment="Stretch" FontSize="18"
            Command="{Binding GoToKreirajPomorcaPageCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="TextBlock.Foreground" Value="#808080"/>
                        </Style>
                    </Button.Styles>      
                </Button>
    </Border>

    
  </Canvas>
</UserControl>