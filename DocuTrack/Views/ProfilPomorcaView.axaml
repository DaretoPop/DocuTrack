<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             x:DataType="vm:PomorciViewModel"
             x:Class="DocuTrack.Views.PomorciView"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             Foreground="White">


  <Grid Background="#808080">

    <!-- CARD -->
    <Border Width="500" Height="650"
            Background="White"
            CornerRadius="30"
            BorderBrush="#e0e0e0" BorderThickness="2"
            BoxShadow="0 10 25 0 #525252" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center">
      <Grid RowDefinitions="*,Auto">
        <!-- WRAP SCROL -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="40">
          <StackPanel Spacing="10">

            <!-- START OF STATIC BUTTONS(DESIGN) -->
            <Button Content="Alice Smith (ID: 1)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
            
            <Button Content="Bob Johnson (ID: 2)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
            
            <Button Content="Charlie Brown (ID: 3)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
            
            <Button Content="David Williams (ID: 4)"
