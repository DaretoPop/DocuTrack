                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
                        <Button Content="Grace Lee (ID: 13)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
                        <Button Content="Hannah Taylor (ID: 14)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
                        <Button Content="Ian Black (ID: 15)"
                    Background="Transparent" Foreground="Black"
                    HorizontalAlignment="Stretch" FontSize="20">
              <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="TextBlock.Foreground" Value="#808080"/>
                </Style>
              </Button.Styles>
            </Button>
            
            
            <Button Content="Jane Black (ID: 16)"
                    Background="Transparent" Foreground="Black"
