<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocuTrack.ViewModels"
             xmlns:views="clr-namespace:DocuTrack.Views"
             x:DataType="vm:CertificateTypeViewModel"
             x:Class="DocuTrack.Views.CertificateTypeView"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             Foreground="#1F2937">

	<UserControl.Styles>
		<Style Selector="ListBox.files-list">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="Height" Value="260"/>
		</Style>
		<Style Selector="ListBox.files-list ListBoxItem">
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="ListBox.files-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#F3F4F6"/>
		</Style>
		<Style Selector="ListBox.files-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.files-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#EAF1F8"/>
		</Style>
	</UserControl.Styles>

	<LayoutTransformControl>
		<LayoutTransformControl.LayoutTransform>
			<ScaleTransform ScaleX="{Binding ScalingFactor}"
			                ScaleY="{Binding ScalingFactor}"/>
		</LayoutTransformControl.LayoutTransform>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Grid RowDefinitions="Auto,Auto,Auto" Margin="40,32">

				<!-- Header: back + title -->
				<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
					<Button Grid.Column="0" Content="← Nazad" Classes="secondary-button"
					        Command="{Binding GoToBackCommand}" Margin="0,0,20,0"/>
					<TextBlock Grid.Column="1" Text="Novi / Izmeni" Classes="page-title"/>
				</Grid>

				<!-- Type name bar -->
				<Border Grid.Row="1" Classes="card" Padding="24,18" Margin="0,0,0,20">
					<Grid ColumnDefinitions="*,Auto">
						<StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
							<TextBlock Text="Ime tipa" Classes="field-label"/>
							<TextBlock Text="{Binding Name}" Classes="field-value" FontSize="20"/>
						</StackPanel>
						<Button Grid.Column="1" Content="Izmeni" Classes="primary-button"
						        VerticalAlignment="Center"
						        Command="{Binding GoToEditCommand}"/>
					</Grid>
				</Border>

				<!-- Three sections side by side -->
				<Grid Grid.Row="2" ColumnDefinitions="*,20,*,20,*">

					<!-- Sticanje -->
					<Border Grid.Column="0" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="12">
							<TextBlock Text="Sticanje" Classes="section-title"/>
							<ListBox Classes="files-list" ItemsSource="{Binding SticanjeFiles}"
							         ScrollViewer.VerticalScrollBarVisibility="Auto">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<views:RequestFileRowView DataContext="{Binding}"/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Button Content="+ Dodaj zahtev za sticanje" Classes="secondary-button"
							        HorizontalAlignment="Stretch"
							        Command="{Binding DodajZahtevZaSticanjeCommand}"
							        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
						</StackPanel>
					</Border>

					<!-- Obnova -->
					<Border Grid.Column="2" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="12">
							<TextBlock Text="Obnova" Classes="section-title"/>
							<ListBox Classes="files-list" ItemsSource="{Binding ObnovaFiles}"
							         ScrollViewer.VerticalScrollBarVisibility="Auto">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<views:RequestFileRowView DataContext="{Binding}"/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Button Content="+ Dodaj zahtev za obnovu" Classes="secondary-button"
							        HorizontalAlignment="Stretch"
							        Command="{Binding DodajZahtevZaObnovuCommand}"
							        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
						</StackPanel>
					</Border>

					<!-- Refresh -->
					<Border Grid.Column="4" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="12">
							<TextBlock Text="Refresh" Classes="section-title"/>
							<ListBox Classes="files-list" ItemsSource="{Binding RefreshFiles}"
							         ScrollViewer.VerticalScrollBarVisibility="Auto">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<views:RequestFileRowView DataContext="{Binding}"/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Button Content="+ Dodaj zahtev za refresh" Classes="secondary-button"
							        HorizontalAlignment="Stretch"
							        Command="{Binding DodajZahtevZaRefreshCommand}"
							        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
		</ScrollViewer>
	</LayoutTransformControl>
</UserControl>